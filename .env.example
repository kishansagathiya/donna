OPENROUTER_API_KEY=
OPENAI_API_KEY=
CARTESIA_API_KEY=
ELEVENLABS_API_KEY=

# Supabase — JWT verification on /voice + conversation persistence + knowledge base
# One-time: run supabase/migrations/0000_init.sql then 0001_memory_upgrade.sql
#   in Supabase SQL Editor (or apply knowledge_base.sql + notes.sql then 0001).
# Create Storage buckets: conversation-audio, knowledge-assets
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_ROLE_KEY=
JWT_AUDIENCE=authenticated

DONNA_HOST=0.0.0.0
DONNA_PORT=8787

# donna-app voice backend (synced on npm start — no code edits needed)
# local (default) | production
DONNA_VOICE_TARGET=local
# Public privacy policy URL (synced to donna-app on npm start)
# DONNA_PRIVACY_POLICY_URL=https://donna-web-production-3d4a.up.railway.app/privacy
# Physical iPhone for npm run dev:iphone (name or UDID; UDID is most reliable)
# DONNA_IOS_DEVICE=00008140-001A12345678901C
# Dev Mac host is auto-detected (Bonjour .local) on npm start — no IP to configure
# Optional full WebSocket URL override (e.g. ws://127.0.0.1:8787/voice for Simulator edge cases)
# DONNA_VOICE_WS_URL=ws://127.0.0.1:8787/voice
# Required — OpenRouter model slug (change here to try a new model; no code changes needed)
# Google Gemini models may 403 on some OpenRouter accounts; deepseek-v4-pro is a reliable default.
DONNA_LLM_MODEL=deepseek/deepseek-v4-pro
# Comma-separated allowlist shown to users. The default above is always included.
DONNA_LLM_MODELS=deepseek/deepseek-v4-pro,anthropic/claude-sonnet-4,openai/gpt-4.1
DONNA_STT_MODEL=mistralai/voxtral-mini-transcribe
# Embedding model for hybrid memory search (needs OPENAI_API_KEY). Defaults to text-embedding-3-small.
# DONNA_EMBEDDING_MODEL=text-embedding-3-small
DONNA_SYSTEM_PROMPT=You are Donna, a sharp and thoughtful voice companion. Give the best answer you can — accurate, specific, and genuinely useful. Default to 2–4 sentences for simple questions; go longer when the topic needs it or the user asks you to explain, compare, or go deeper. Be warm and direct, not robotic. If you're unsure or the question needs up-to-date information you don't have, say so plainly instead of guessing. Use what you know about this user when it's relevant; don't force personal details into every reply. Never ask the user to repeat themselves.
