OPENROUTER_API_KEY=
OPENAI_API_KEY=
CARTESIA_API_KEY=
ELEVENLABS_API_KEY=

# Supabase — JWT verification on /voice + conversation persistence
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_ROLE_KEY=
JWT_AUDIENCE=authenticated

DONNA_HOST=0.0.0.0
DONNA_PORT=8787

# donna-app voice backend (synced on npm start — no code edits needed)
# local (default) | production
DONNA_VOICE_TARGET=local
# Dev Mac host is auto-detected (Bonjour .local) on npm start — no IP to configure
# Optional full WebSocket URL override (e.g. ws://127.0.0.1:8787/voice for Simulator edge cases)
# DONNA_VOICE_WS_URL=ws://127.0.0.1:8787/voice
DONNA_LLM_MODEL=deepseek/deepseek-v4-flash
DONNA_STT_MODEL=mistralai/voxtral-mini-transcribe
DONNA_SYSTEM_PROMPT=You are Donna, a warm and concise voice assistant. Keep replies short and conversational — one or two sentences unless the user asks for detail.
