OPENROUTER_API_KEY=
OPENAI_API_KEY=
CARTESIA_API_KEY=
ELEVENLABS_API_KEY=

# Supabase — JWT verification on /voice + conversation persistence + knowledge base
# One-time: run supabase/migrations/0000_init.sql then 0001_memory_upgrade.sql
#   in Supabase SQL Editor (or apply knowledge_base.sql + notes.sql then 0001).
# Create Storage buckets: conversation-audio, knowledge-assets
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_ROLE_KEY=
JWT_AUDIENCE=authenticated

DONNA_HOST=0.0.0.0
DONNA_PORT=8787

# donna-app voice backend (synced on npm start — no code edits needed)
# local (default) | production
DONNA_VOICE_TARGET=local
# Public privacy policy URL (synced to donna-app on npm start)
# DONNA_PRIVACY_POLICY_URL=https://donna-web-production-3d4a.up.railway.app/privacy
# Physical iPhone for npm run dev:iphone (name or UDID; UDID is most reliable)
# DONNA_IOS_DEVICE=00008140-001A12345678901C
# Dev Mac host is auto-detected (Bonjour .local) on npm start — no IP to configure
# Optional full WebSocket URL override (e.g. ws://127.0.0.1:8787/voice for Simulator edge cases)
# DONNA_VOICE_WS_URL=ws://127.0.0.1:8787/voice
# Required — OpenRouter model slug (change here to try a new model; no code changes needed)
# Google Gemini models may 403 on some OpenRouter accounts; deepseek-v4-pro is a reliable default.
DONNA_LLM_MODEL=deepseek/deepseek-v4-pro
# Optional cheaper/faster model for auto-routing simple prompts and history summarization.
# DONNA_LLM_FAST_MODEL=deepseek/deepseek-v4-flash
# When true and DONNA_LLM_FAST_MODEL is set, route simple prompts to the fast model
# unless the user has an explicit llm_model preference.
# DONNA_LLM_AUTO_ROUTE=false
# Comma-separated allowlist shown to users. The default above (DONNA_LLM_MODEL) is always included.
# The `:online` suffix enables OpenRouter's web-search augmentation (supported on most models).
# kimi-k3 is a reasoning model — Donna excludes streamed reasoning and raises max_tokens for it.
DONNA_LLM_MODELS=deepseek/deepseek-v4-pro,deepseek/deepseek-v4-pro:online,z-ai/glm-5.2,z-ai/glm-5.2:online,moonshotai/kimi-k2.6,moonshotai/kimi-k3,moonshotai/kimi-k3:online
# OpenRouter vision model for image ingest and in-turn image attachments. Defaults to z-ai/glm-4.6v.
DONNA_VISION_MODEL=z-ai/glm-4.6v
DONNA_STT_MODEL=mistralai/voxtral-mini-transcribe
# Embedding model for hybrid memory search (needs OPENAI_API_KEY). Defaults to text-embedding-3-small.
# DONNA_EMBEDDING_MODEL=text-embedding-3-small
# Minimum blended match_memory score (0–1) to inject a fact. Defaults to 0.35.
# DONNA_MEMORY_MIN_SCORE=0.35
# Max recent chat messages kept verbatim; older turns are summarized when over this cap. Defaults to 20.
# DONNA_MAX_HISTORY_MESSAGES=20
DONNA_SYSTEM_PROMPT=You are Donna, a sharp and thoughtful second-brain companion for text and voice. Give the best answer you can — accurate, specific, and genuinely useful. Default to 2–4 sentences for simple questions; go longer when the topic needs it or the user asks you to explain, compare, or go deeper. For spoken replies, prefer 1–2 short sentences unless the user asks for depth. Be warm and direct, not robotic. If you're unsure or the question needs up-to-date information you don't have, say so plainly instead of guessing. Use what you know about this user when it's relevant; don't force personal details into every reply. Never ask the user to repeat themselves.

# Chat mid-turn tools (fetch_url / browse_page). Default on.
# DONNA_CHAT_TOOLS=true
# Playwright sidecar for browse_page (optional).
# DONNA_BROWSER_URL=http://127.0.0.1:9229

# Integrations (Granola + Google Calendar). Disabled by default — enable internally first.
# DONNA_INTEGRATIONS_ENABLED=false
# DONNA_GRANOLA_ENABLED=false
# DONNA_GOOGLE_ENABLED=false
# Google OAuth web client (Calendar events + Gmail send scopes). Redirect: {DONNA_PUBLIC_API_BASE}/integrations/google/callback
# DONNA_GOOGLE_OAUTH_CLIENT_ID=
# DONNA_GOOGLE_OAUTH_CLIENT_SECRET=
# Required when integrations are enabled: base64-encoded 32-byte AES-256-GCM key.
# Example generate: openssl rand -base64 32
# DONNA_CONNECTOR_ENCRYPTION_KEY=
# Public API origin used as OAuth redirect_uri base (…/integrations/{provider}/callback).
# DONNA_PUBLIC_API_BASE=https://donna-server-go-production.up.railway.app
# Web app origin for post-OAuth redirect to /app?integrations=granola|google.
# Defaults to https://donnadoesit.com (legacy donna-web*.up.railway.app values are rewritten).
# DONNA_WEB_APP_BASE=https://donnadoesit.com

# Notes & Memory V2 foundation (#156): server defaults (all off until rollout).
# Per-user overrides: user_preferences.flag_notes_v2_* / flag_memory_v2_* columns (migration 0014).
# DONNA_NOTES_V2_FEED=false
# DONNA_NOTES_V2_SMART_TAGGING=false
# DONNA_MEMORY_V2_EXTRACTION=false
# DONNA_MEMORY_V2_RETRIEVAL=false
# DONNA_BACKGROUND_JOBS=false

